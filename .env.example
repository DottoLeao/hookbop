# Copy to .env.local and fill in. Local values: run `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=
# Server only: it skips every access rule. Never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Server only: the key for "Não entendi" and "Traduzir verso". Never give it a NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=
# What players can use (src/lib/entitlements.ts): closed_beta gives every extra away free, with no ads. It is read
# when the app is built, so a change needs a new build. Only "public" turns the ad-backed extras on.
NEXT_PUBLIC_APP_PHASE=closed_beta
